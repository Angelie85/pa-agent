# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Twilio — https://console.twilio.com/
# For dev: use the WhatsApp sandbox number (whatsapp:+14155238886)
# For production: request a real WhatsApp Business number
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# YOUR WhatsApp number (with country code, prefixed with "whatsapp:")
# Only messages from this number will be answered.
YOUR_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application).
# Add http://localhost:3000/oauth/callback (or your PUBLIC_URL) to authorized redirect URIs.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Personal
TIMEZONE=America/New_York
USER_NAME=Angelie

# Morning brief time (cron format, in TIMEZONE above). Default: 8am Mon–Fri
MORNING_BRIEF_CRON=0 8 * * 1-5

# Server
PORT=3000
